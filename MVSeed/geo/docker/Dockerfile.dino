# S1-E3: DINOv2 correspondence provider (G-corr), inference only.
#   docker build -f MVSeed/geo/docker/Dockerfile.dino -t scgeo:dino MVSeed/geo/docker
# DINOv2 code and weights: Apache-2.0 (facebook/dinov2-*).  DINOv3 is excluded (gated licence,
# docs/stage1-plan.md section 3).  The scsam3 / scgeo:pi3 / 3dgs images have no `transformers`,
# so the correspondence pass gets its own image and hands prompts to SAM 3 through a JSON file.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir numpy==1.26.4 pillow opencv-python-headless \
    "transformers==4.46.3" huggingface_hub safetensors

# bake the weights in so the container can run fully offline, as scgeo:pi3 does
ENV HF_HOME=/opt/hf
RUN python -c "from huggingface_hub import snapshot_download; \
snapshot_download('facebook/dinov2-large'); snapshot_download('facebook/dinov2-base')"
ENV HF_HUB_OFFLINE=1
WORKDIR /work
