+    def _trim_cached_frame_outputs(self, inference_state, keep_frame_idx, reverse=False):
+        """Drop already-consumed frame entries from `cached_frame_outputs`.
+
+        The cache exists so a later partial propagation can MERGE a refined
+        object into the VG predictions already stored for each frame
+        (`_build_tracker_output` reads the current frame's entry as its merge
+        base).  When the caller walks forward once and consumes each frame as
+        it is yielded - what the MVSeg runner does - those past entries are
+        dead weight, and at (views x objects x frames) full-resolution masks
+        they are what exhausts host RAM.
+
+        Two guards keep this from corrupting the interactive path:
+          * only strictly-past frames are dropped, never one the walk has not
+            reached yet;
+          * a session that has ever run a full VG propagation is left alone,
+            because then every frame carries predictions this loop is meant to
+            merge into.
+        Off unless SCSAM3_TRIM_CACHED_OUTPUTS is set to a non-zero value.
+        """
+        if not TRIM_CACHED_OUTPUTS:
+            return
+        for action in inference_state.get("action_history", ()):
+            if action.get("type") == "propagation_full":
+                return
+        cache = inference_state.get("cached_frame_outputs")
+        if not cache:
+            return
+        for f in [f for f in cache
+                  if (f > keep_frame_idx if reverse else f < keep_frame_idx)]:
+            del cache[f]
